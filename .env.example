# Скопируйте этот файл в .env и подставьте свои значения.
# Сам .env закрыт в .gitignore и в репозиторий не попадёт.

# ── измерение скорости ───────────────────────────────────────────────────────
# Ключ к сервису PageSpeed Insights. Бесплатный.
# console.cloud.google.com -> APIs & Services -> Credentials -> Create API key
# Сразу поставьте ограничения: только PageSpeed Insights API и только ваш IP.
# Без ключа работают десять инструментов из одиннадцати.
PAGESPEED_KEY=

# ── доступ к модели ──────────────────────────────────────────────────────────
# Берётся на console.anthropic.com -> API keys -> Create Key.
# Оплата отдельная от подписки Claude Code: она на API не распространяется.
#
# Не обязателен. Без него бот работает в режиме без модели: те же проверки
# и те же находки, только порядок задан заранее, а не выбирается по ходу.
# Появится ключ — при следующем запуске включится агент.
ANTHROPIC_API_KEY=

# Модель по умолчанию. Можно не задавать.
# claude-opus-5 — самая точная, claude-sonnet-5 дешевле, claude-haiku-4-5 ещё дешевле.
# REVIZOR_MODEL=claude-opus-5

# ── телеграм-бот ─────────────────────────────────────────────────────────────
# Токен выдаёт @BotFather в Telegram: /newbot и следовать подсказкам.
TELEGRAM_BOT_TOKEN=

# Ограничения. Каждая проверка стоит денег, поэтому лучше не убирать.
# BOT_DAILY_LIMIT=5
# BOT_COOLDOWN_MINUTES=2
# BOT_QUEUE_LIMIT=5

# Коды доступа. Если заданы, посторонний должен один раз прислать код.
# Удобно для отклика на вакансию: код пишется в письме вместе со ссылкой.
#
# Кодов можно перечислить несколько через запятую и у каждого поставить дату,
# после которой он перестаёт работать. Свой код на каждый отклик — видно,
# кто пришёл, и старые закрываются сами. Уже вошедших смена кода не выкидывает.
#
# Слова ниже — образец. Свои коды держите только в .env: всё, что попадёт
# в репозиторий, считается известным всем.
# BOT_ACCESS_CODE=первое-слово, второе-слово:2026-09-30, третье-слово

# Общий потолок проверок в сутки на всех вместе. Страховка кошелька:
# личные лимиты не спасают, если людей много. 0 или пусто — без потолка.
# BOT_GLOBAL_DAILY_LIMIT=20

# Полностью закрытый режим: проверки доступны только этим людям.
# Свой числовой идентификатор можно узнать у бота @userinfobot.
# TELEGRAM_ALLOWED_USERS=123456789

# Кому показывать расход токенов и стоимость прогона.
# TELEGRAM_ADMINS=123456789
